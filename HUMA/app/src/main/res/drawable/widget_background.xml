<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background Utama (Soft Blue/Indigo) -->
    <item>
        <shape>
            <solid android:color="#E8EAF6"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>

    <!-- Pola Garis Diagonal -->
    <item android:top="20dp" android:right="-40dp">
        <rotate android:fromDegrees="45">
            <shape>
                <size android:width="200dp" android:height="2dp"/>
                <solid android:color="#1A6C63FF"/>
            </shape>
        </rotate>
    </item>

    <!-- Pola Lingkaran di Pojok -->
    <item android:top="-40dp" android:left="-40dp">
        <shape>
            <size android:width="100dp" android:height="100dp"/>
            <solid android:color="#1A6C63FF"/>
            <corners android:radius="50dp"/>
        </shape>
    </item>

    <!-- Border Halus -->
    <item>
        <shape>
            <stroke android:width="1dp" android:color="#336C63FF"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
</layer-list>